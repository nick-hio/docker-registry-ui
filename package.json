{
  "name": "docker-registry-ui",
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "start": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "format": "prettier --write src test index.html vite.config.ts tsconfig.json components.json package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Joxit/docker-registry-ui.git"
  },
  "author": "Jones Magloire (Joxit)",
  "license": "AGPL-3.0",
  "description": "A web UI for private docker registry",
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "0.577.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
